
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Responsive Page with User Menu</title>

  
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  
  
  
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <style>
    body {
      background-color: #f8f9fa;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      background-color: #0d6efd;
      color: white;
    }

    main {
      flex-grow: 1;
      padding: 1.5rem;
    }

    footer {
      background-color: #212529;
      color: #fff;
      text-align: center;
      padding: 0.75rem;
    }

    .header-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .center-section {
      flex-grow: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .company-logo {
      width: 36px;
      height: 36px;
      background-color: #ffffff33;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 10px;
      font-size: 1.2rem;
    }

    .company-name {
      font-weight: 600;
      font-size: 1.25rem;
    }

    .profile-btn {
      color: white;
      border: none;
      background: transparent;
    }

    .profile-btn:hover,
    .profile-btn:focus {
      color: #e2e6ea;
    }

    .dropdown-menu-end {
      right: 0;
      left: auto;
    }
    .error {
      background: #ffdddd;
      padding: 12px;
      border-left: 4px solid #e00;
      margin-bottom: 16px;
      cursor: pointer;
    }
  </style>
</head>
<body>

  
  <header class="p-3">
    <div class="container-fluid header-container">
      
      <button
        class="btn btn-outline-light"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#sidebar"
        aria-controls="sidebar"
      >
        <i class="bi bi-list"></i>
      </button>

      
      <div class="center-section">
        <div class="company-logo">
          <i class="bi bi-building"></i>
        </div>
        <div class="company-name">MC</div>
      </div>

      
      <div class="dropdown">
        <button
          class="profile-btn dropdown-toggle"
          type="button"
          id="profileDropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false"
        >
          <i class="bi bi-person-circle fs-4"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
          <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>My Profile</a></li>
          <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
        </ul>
      </div>
    </div>
  </header>

  
  <div
    class="offcanvas offcanvas-start"
    tabindex="-1"
    id="sidebar"
    aria-labelledby="sidebarLabel"
  >
    <div class="offcanvas-header">
      <h5 class="offcanvas-title" id="sidebarLabel">Navigation</h5>
      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="offcanvas"
        aria-label="Close"
      ></button>
    </div>
    <div class="offcanvas-body p-0">
      <ul class="list-group list-group-flush">
        <li class="list-group-item"><i class="bi bi-house me-2"></i>Home</li>
        <li class="list-group-item"><i class="bi bi-person me-2"></i>Profile</li>
        <li class="list-group-item"><i class="bi bi-gear me-2"></i>Settings</li>
        <li class="list-group-item"><i class="bi bi-question-circle me-2"></i>Help</li>
      </ul>
    </div>
  </div>

  
  <main class="container-fluid">
    <div class="card shadow-sm p-4">
    
      


 <div class="container justify-content-left">
    <h2></h2>
      <h2>Welcome Igor Gabriel Marcos Vinicius Rezend!</h2>
      <p>
        The sidebar is always hidden by default and can be opened with the hamburger button above.
      </p>
      <p>
        The header now includes a user profile dropdown with quick access to key account options.
      </p>
</div>
     <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Conta Corrente</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
          <div class="btn-group me-2">
            <button type="button" class="btn btn-sm btn-outline-secondary">Share</button>
            <button type="button" class="btn btn-sm btn-outline-secondary">Export</button>
          </div>
          <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle">
            <span data-feather="calendar"></span>
            This week
          </button>
        </div>
      </div>
      

  <div class="table-container"> 
    <table class="table"> 
       <tr>
                                          <th class="fs-2 table-primary" colspan="3">Atual</th>
                                   </tr>
      <tr> 
                            <th scope="col"></th>
                            <th scope="col">Real ($)</th>
                            <th scope="col">Ouro (g)</th>
      </tr> 
      <tr> 
                            <td>Crédito</td>
                            <td>$.00</td>
                            <td>$.00</td>
      </tr> 
      <tr> 
                            
                            <td>Débito</td>
                            <td>$.00</td>
                            <td>$.00</td>
       </tr> 
      <tr class="fw-bold"> 
                            <td>Saldo</td>
                            <td>$.00</td>
                            <td>$.00</td>
      </tr> 
    </table> 

    <table class="table"> 
      <th colspan="3"  class="fs-2 table-warning">Renda Potencial / Disponível</th>
      <tr> 
                     <tr>
                            <th scope="col"></th>
                            <th scope="col">Real ($)</th>
                            <th scope="col">Ouro (g)</th>
      </tr> 
      <tr> 
                           <td>Saldo</td>
                            <td>$.00</td>
                            <td>$.00</td>
      </tr> 
                     <tr>
                            <td>A ganhar:</td>
                            <td>$.00</td>
                            <td>$.00</td>
                     </tr>
                      <tr class="fw-bold">
                            <td>Disponível</td>
                            <td>$.00</td>
                            <td>$.00</td>
                     </tr>      
    </table> 
  </div> 


  </main>

  
  <footer>
    <small>&copy; 2025 Madone Logistics. All rights reserved.</small>
  </footer>

  
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.min.js" integrity="sha384-QJHtvGhmr9XOIpI6YVutG+2QOK9T+ZnN4kzFN1RtK3zEFEIsxhlmWl5/YESvpZ13" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/hyperscript.org@0.9.14"></script>   
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.10.2/dist/umd/popper.min.js" integrity="sha384-7+zCNj/IqJ95wo16oMtfsKbZ9ccEh31eOz1HGyDuCQ6wgnyJNSYdrPa03rtR1zdB" crossorigin="anonymous"></script>

</body>
</html>
