{{ define "person_update_dropdown" }}
{{$divId := .DIV_ID}}
<div id="{{.DIV_ID}}" 
	class="dropdown"
	hx-get="{{.HX_URL}}/esc"
	hx-trigger="keyup[key=='Escape']"
	hx-target="#{{.DIV_ID}}"
	hx-swap="outerHTML"
	>
	<button class="btn btn-primary dropdown-toggle" 
		type="button" 
		id="dropdownMenuButton" 
		data-bs-toggle="dropdown" 
		aria-expanded="false"
	>
		{{range .OPTIONS}}{{if .IsCurrent}}{{.Value}}{{end}}{{end}}
	</button>
	<ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
		{{range .OPTIONS}}
		<li>
			<a class="dropdown-item" hx-post="{{.OPTION_URL}}" hx-target="#{{ $divId }}" hx-swap="outerHTML">
				{{.Value}}
			</a>
		</li>
		{{end}}
  	</ul>
</div>
{{end}}