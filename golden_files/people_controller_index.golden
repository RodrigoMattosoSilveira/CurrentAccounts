
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Responsive Page with User Menu</title>

  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

  
  
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

  <style>
    body {
      background-color: #f8f9fa;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      background-color: #0d6efd;
      color: white;
    }

    main {
      flex-grow: 1;
      padding: 1.5rem;
    }

    footer {
      background-color: #212529;
      color: #fff;
      text-align: center;
      padding: 0.75rem;
    }

    .header-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .center-section {
      flex-grow: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .company-logo {
      width: 36px;
      height: 36px;
      background-color: #ffffff33;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 10px;
      font-size: 1.2rem;
    }

    .company-name {
      font-weight: 600;
      font-size: 1.25rem;
    }

    .profile-btn {
      color: white;
      border: none;
      background: transparent;
    }

    .profile-btn:hover,
    .profile-btn:focus {
      color: #e2e6ea;
    }

    .dropdown-menu-end {
      right: 0;
      left: auto;
    }
    .form-row-grid {
      display: grid;
      grid-template-columns: 72px 1fr;  
      column-gap: 0.375rem;             
      row-gap: 0.125rem;
      align-items: baseline
  }
 
.table-scroll {
  max-height: 925px;  
  overflow-y: auto;   
}

 
.table-scroll thead th {
  position: sticky;
  top: 0;
  background-color: #fff;  
  z-index: 2;  
}
  </style>
</head>
<body hx-ext="response-targets">

  
  <header class="p-3">
    <div class="container-fluid header-container">
      
      <button
        class="btn btn-outline-light"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#sidebar"
        aria-controls="sidebar"
      >
        <i class="bi bi-list"></i>
      </button>

      
      <div class="center-section">
        <div class="company-logo">
          <i class="bi bi-building"></i>
        </div>
        <div class="company-name">MC</div>
      </div>

      
      <div class="dropdown">
        <button
          class="profile-btn dropdown-toggle"
          type="button"
          id="profileDropdown"
          data-bs-toggle="dropdown"
          aria-expanded="false"
        >
          <i class="bi bi-person-circle fs-4"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
          <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>My Profile</a></li>
          <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
        </ul>
      </div>
    </div>
  </header>

  
  <div
    class="offcanvas offcanvas-start"
    tabindex="-1"
    id="sidebar"
    aria-labelledby="sidebarLabel"
  >
    <div class="offcanvas-header">
      <h5 class="offcanvas-title" id="sidebarLabel">Navigation</h5>
      <button
        type="button"
        class="btn-close"
        data-bs-dismiss="offcanvas"
        aria-label="Close"
      ></button>
    </div>
    <div class="offcanvas-body p-0">
      <ul class="list-group list-group-flush">
        <li class="list-group-item"><i class="bi bi-house me-2"></i>Home</li>
        <li class="list-group-item"><i class="bi bi-person me-2"></i>Profile</li>
        <li class="list-group-item"><i class="bi bi-gear me-2"></i>Settings</li>
        <li class="list-group-item"><i class="bi bi-question-circle me-2"></i>Help</li>
      </ul>
    </div>
  </div>

  
  <main class="container-fluid">
    
<h4> People </h4>
<div class="table-scroll">
<table class="table table-striped table-bordered table-hover  w-auto">

	<thead>
		<tr>
			<th class="sticky-header" scope="col">Name</th>
			<th class="sticky-header" scope="col">Cell</th>
			<th class="sticky-header" scope="col">Del</th>
		</tr>
	</thead>
	<tbody id="person-table-body">
		
			
 <div class="table-scroll">
<tr id="person-120">
    <td>João Edson Rodrigues</td>
    <td>(19) 98874-1351</td>
     <td>
        <button 
            class="bi bi-person-fill-slash btn btn-danger"
            hx-delete="/people/120"
            hx-target="#person-120"
            hx-swap="outerHTML"
            hx-confirm="Are you sure you want to delete this person?"
        >
        </button>
    </td>
</tr>


		
			
 <div class="table-scroll">
<tr id="person-121">
